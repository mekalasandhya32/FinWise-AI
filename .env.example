# ============================================================
# FinWise AI — Environment Variables (copy to .env, never commit)
# ============================================================

# --- Frontend (TanStack Start + React) -----------------------
# Lovable AI Gateway key — powers streaming Claude for the AI Advisor.
LOVABLE_API_KEY=your-lovable-api-key

# Optional: direct Anthropic Claude API key (advanced use only).
CLAUDE_API_KEY=your-claude-api-key

# Google Apps Script Web App URL (Sheets webhook).
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXX/exec

# --- Backend (Flask reference stack) -------------------------
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-to-a-long-random-string
HOST=0.0.0.0
PORT=5000

# Groq (used by the Flask reference AI advisor).
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.1-70b-versatile

# Google Sheets (Flask persistence).
GOOGLE_SHEETS_ID=your-google-sheet-id
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
