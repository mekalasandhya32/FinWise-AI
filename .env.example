# ===========================================
# FinWise AI — Root Environment Template
# Copy to `.env` and fill in real values.
# NEVER commit the resulting .env file.
# ===========================================

# --- Frontend (TanStack Start + React) ---
# Lovable AI Gateway key powering the streaming AI Advisor
LOVABLE_API_KEY=your-lovable-api-key

# Google Apps Script Web App URL (Sheets webhook)
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXX/exec

# --- Backend (Flask reference stack) ---
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-to-a-long-random-string

HOST=0.0.0.0
PORT=5000

# Groq (direct provider) — used by the Flask AI Advisor
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.1-70b-versatile

# Google Sheets (Flask persistence)
GOOGLE_SHEETS_ID=your-google-sheet-id
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
